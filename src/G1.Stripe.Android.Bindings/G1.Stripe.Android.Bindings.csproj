<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsTrimmable>true</IsTrimmable>
		<PackageTags>sdk_version=$(_AndroidSdkVersion)</PackageTags>
		<NoWarn>XAOBS001;CS0108</NoWarn>
	</PropertyGroup>

	<!-- ============================================================ -->
	<!-- Maven: Stripe SDK                                            -->
	<!-- ============================================================ -->
	<ItemGroup>
		<!-- Bound -->
		<AndroidMavenLibrary Include="com.stripe:stripe-android"             Version="$(_AndroidSdkVersion)" />
		<AndroidMavenLibrary Include="com.stripe:stripe-core"                Version="$(_AndroidSdkVersion)" />
		<AndroidMavenLibrary Include="com.stripe:payments-core"              Version="$(_AndroidSdkVersion)" />
		<AndroidMavenLibrary Include="com.stripe:payments-model"             Version="$(_AndroidSdkVersion)" />
		<AndroidMavenLibrary Include="com.stripe:paymentsheet"               Version="$(_AndroidSdkVersion)" />

		<!-- Transitive (not bound) -->
		<AndroidMavenLibrary Include="com.stripe:stripe-ui-core"             Version="$(_AndroidSdkVersion)" Bind="False" />
		<AndroidMavenLibrary Include="com.stripe:payments-ui-core"           Version="$(_AndroidSdkVersion)" Bind="False" />
		<AndroidMavenLibrary Include="com.stripe:stripe-3ds2-android"        Version="$(_AndroidSdkVersion)" Bind="False" />
		<AndroidMavenLibrary Include="com.stripe:hcaptcha"                   Version="$(_AndroidSdkVersion)" Bind="False" />
		<AndroidMavenLibrary Include="com.stripe:attestation"                Version="$(_AndroidSdkVersion)" Bind="False" />
		<AndroidMavenLibrary Include="com.stripe:financial-connections-core" Version="$(_AndroidSdkVersion)" Bind="False" />
		<AndroidMavenLibrary Include="com.stripe:financial-connections-lite" Version="$(_AndroidSdkVersion)" Bind="False" />
	</ItemGroup>

	<!-- ============================================================ -->
	<!-- Maven: additional transitive deps (not on NuGet)             -->
	<!-- ============================================================ -->
	<ItemGroup>
		<!-- Accompanist theme adapters -->
		<AndroidMavenLibrary Include="com.google.accompanist:accompanist-themeadapter-core"      Version="0.36.0" Bind="False" />
		<AndroidMavenLibrary Include="com.google.accompanist:accompanist-themeadapter-appcompat" Version="0.36.0" Bind="False" />
		<AndroidMavenLibrary Include="com.google.accompanist:accompanist-themeadapter-material"  Version="0.36.0" Bind="False" />
		<AndroidMavenLibrary Include="com.google.accompanist:accompanist-themeadapter-material3" Version="0.36.0" Bind="False" />

		<!-- Google Pay (Compose) -->
		<AndroidMavenLibrary Include="com.google.pay.button:compose-pay-button"                  Version="0.1.3"  Bind="False" />

		<!-- Kotlin runtime extensions -->
		<AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-parcelize-runtime"             Version="2.2.21" Bind="False" />

		<!-- DI / annotations -->
		<AndroidMavenLibrary Include="com.google.dagger:dagger"                                  Version="2.58"   Bind="False" />
		<AndroidMavenLibrary Include="jakarta.inject:jakarta.inject-api"                         Version="2.0.1"  Bind="False" />
		<AndroidMavenLibrary Include="javax.inject:javax.inject"                                 Version="1"      Bind="False" />
		<AndroidMavenLibrary Include="org.jspecify:jspecify"                                     Version="1.0.0"  Bind="False" />
		<AndroidMavenLibrary Include="dev.drewhamilton.poko:poko-annotations"                    Version="0.21.1" Bind="False" />

		<!-- Misc -->
		<AndroidMavenLibrary Include="com.jakewharton:disklrucache"                              Version="2.0.2"  Bind="False" />
		<AndroidMavenLibrary Include="com.nimbusds:nimbus-jose-jwt"                              Version="10.6"   Bind="False" />
	</ItemGroup>

	<!-- ============================================================ -->
	<!-- NuGet: Kotlin                                                -->
	<!-- ============================================================ -->
	<ItemGroup>
		<PackageReference Include="Xamarin.Kotlin.StdLib"                          Version="2.3.20" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7"                     Version="2.3.20" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8"                     Version="2.3.20" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Core"                Version="1.10.2.3" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Android"             Version="1.10.2.3" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Play.Services"       Version="1.10.2.3" />
		<PackageReference Include="Xamarin.KotlinX.Serialization.Json"             Version="1.10.0.1" />
	</ItemGroup>

	<!-- ============================================================ -->
	<!-- NuGet: AndroidX core / appcompat / misc                      -->
	<!-- ============================================================ -->
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Annotation"                    Version="1.9.1.7" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat"                     Version="1.7.1.3" />
		<PackageReference Include="Xamarin.AndroidX.Browser"                       Version="1.9.0.2" />
		<PackageReference Include="Xamarin.AndroidX.ConstraintLayout"              Version="2.2.1.5" />
		<PackageReference Include="Xamarin.AndroidX.Core"                          Version="1.18.0" />
		<PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx"                 Version="1.18.0" />
		<PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding"       Version="9.1.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx"                  Version="1.8.9.2" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView"                  Version="1.4.0.5" />
		<PackageReference Include="Xamarin.AndroidX.WebKit"                        Version="1.15.0.2" />
	</ItemGroup>

	<!-- ============================================================ -->
	<!-- NuGet: AndroidX Activity / Lifecycle / Navigation            -->
	<!-- ============================================================ -->
	<ItemGroup>
		<!-- Activity -->
		<PackageReference Include="Xamarin.AndroidX.Activity.Compose"              Version="1.13.0" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx"                  Version="1.13.0" />

		<!-- Lifecycle -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Common"              Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core"       Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Ktx"        Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime"             Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx"         Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Compose"     Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel"           Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx"       Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.10.0.2" />

		<!-- Navigation -->
		<PackageReference Include="Xamarin.AndroidX.Navigation.Compose"            Version="2.9.7.1" />
	</ItemGroup>

	<!-- ============================================================ -->
	<!-- NuGet: AndroidX Compose                                      -->
	<!-- ============================================================ -->
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Compose.Foundation"				Version="1.10.6" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Material"				Version="1.10.6" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Material3"				Version="1.4.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Material.Icons.Core"	Version="1.7.8.5" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Runtime"				Version="1.10.6" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI"						Version="1.10.6" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI.Tooling.Preview"		Version="1.10.6" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI.ViewBinding"			Version="1.10.6" />
	</ItemGroup>


	<!-- ============================================================ -->
	<!-- NuGet: Google / Material / Play / Accompanist                -->
	<!-- ============================================================ -->
	<ItemGroup>
		<PackageReference Include="Xamarin.Google.Android.Material"                Version="1.13.0.2" />
		<PackageReference Include="Xamarin.Google.Android.Play.Integrity"          Version="1.4.0.5" />
		<PackageReference Include="Xamarin.GooglePlayServices.Wallet"              Version="119.5.0.2" />
		<PackageReference Include="Xamarin.Google.Accompanist.FlowLayout"          Version="0.36.0" />
		<PackageReference Include="Xamarin.Google.Accompanist.SystemUIController"  Version="0.36.0" />
	</ItemGroup>

	<!-- ============================================================ -->
	<!-- Local AAR files (not available via NuGet)                    -->
	<!-- ============================================================ -->
	<ItemGroup>
		<AndroidLibrary Update="Jars\instantapps-1.1.0.aar" JavaArtifact="com.google.android.instantapps:instantapps:1.1.0" JavaVersion="1.1.0" Bind="False" />
	</ItemGroup>

</Project>